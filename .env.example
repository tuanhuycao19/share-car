# ============================================================
# Share Car — biến môi trường dùng chung cho local dev & Docker
# Sao chép:  cp .env.example .env
# ============================================================

# ---------- PostgreSQL + PostGIS ----------
POSTGRES_USER=sharecar
POSTGRES_PASSWORD=sharecar
POSTGRES_DB=sharecar
POSTGRES_PORT=5432
# Khi chạy API trên máy host (pnpm dev). Trong Docker Compose, host được ghi đè thành "postgres".
DATABASE_URL=postgresql://sharecar:sharecar@localhost:5432/sharecar?schema=public

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- API (NestJS) ----------
API_PORT=4000
# Danh sách origin được phép gọi API, phân tách bởi dấu phẩy
CORS_ORIGINS=http://localhost:3000
# BẮT BUỘC đổi ở môi trường thật (chuỗi ngẫu nhiên >= 32 ký tự)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Giới hạn đăng nhập sai (Redis): số lần / cửa sổ giây
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# ---------- Matching engine (FastAPI) ----------
ENGINE_PORT=8000
ENGINE_URL=http://localhost:8000
ENGINE_TIMEOUT_MS=2000
# Bán kính (km) quanh tuyến đường để lọc ứng viên bằng PostGIS trước khi gửi sang engine
MATCH_CORRIDOR_KM=15

# ---------- Web (Next.js) ----------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
